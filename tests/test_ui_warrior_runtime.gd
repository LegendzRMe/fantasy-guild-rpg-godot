	main.load_warrior_test_build(warrior,1);var boss:Dictionary=main.enemies.filter(func(enemy):return str(enemy.get("target_category",""))=="boss")[0];boss.pos=warrior.pos+Vector2(40,0);main.focused_enemy_index=main.enemies.find(boss);TestSupport.check(errors,main.cast_warrior_heroic(warrior) and main.ForcedTargetSystem.preferred(boss)==0 and main.CombatSystem.is_silenced(boss),"Taunt should force even a Boss to target the Warrior and apply the Silence control profile.")
	warrior.warrior_runtime.heroic_strike_cooldown=0.0;boss.hp=boss.max_hp;main.deal_damage(warrior,boss,float(warrior.damage),"basic_attack","physical","Warrior Basic Attack");TestSupport.check(errors,is_equal_approx(main.HealingReceivedModifierSystem.multiplier(boss),.6),"A successful live Heroic Strike with Mortal Strike should reduce healing received by 40%.")
