const TestSupport=preload("res://tests/test_support.gd")

static func run(main:Node)->Array:
	var errors:Array=[];var save_index:int=main.state.heroes.find_custom(func(saved):return str(saved.get("class",""))=="Warrior")
	if save_index<0:TestSupport.check(errors,false,"The testing save should include a Warrior runtime fixture.");return errors
	main.state.selected_team=[save_index];main.state.active_team=[save_index];main.start_warrior_testing_zone();var warrior:Dictionary=main.heroes[0];main.selected=0
	TestSupport.check(errors,main.testing_zone_mode=="warrior_range" and main.enemies.any(func(enemy):return str(enemy.get("target_category",""))=="summon") and main.enemies.any(func(enemy):return str(enemy.get("target_category",""))=="boss") and main.combat_blockers.any(func(blocker):return str(blocker.get("combat_id",""))=="blocker:warrior_landing"),"Warrior Range should launch with summon, Boss, shield, and safe-landing fixtures.")

	main.load_warrior_test_build(warrior,0);warrior.critical_chance=0.0;var target:Dictionary=main.enemies[0];target.armor=0.0;target.shield=0.0;target.hp=1000.0;target.max_hp=1000.0;warrior.warrior_runtime.heroic_strike_cooldown=0.0;var hp_before:=float(target.hp)
	main.deal_damage(warrior,target,float(warrior.damage),"basic_attack","physical","Warrior Basic Attack")
	TestSupport.check(errors,is_equal_approx(hp_before-float(target.hp),199.0) and is_equal_approx(float(warrior.warrior_runtime.heroic_strike_cooldown),15.0),"A live empowered Basic Attack should resolve 74 primary plus a separate 125 Heroic Strike packet, then apply three-second CDR.")
	main.EvasionSystem.activate(target,1.0,"warrior_test");warrior.warrior_runtime.heroic_strike_cooldown=0.0;main.deal_damage(warrior,target,float(warrior.damage),"basic_attack","physical","Warrior Basic Attack")
	TestSupport.check(errors,is_equal_approx(float(warrior.warrior_runtime.heroic_strike_cooldown),18.0),"A live evaded empowered attack should consume the proc and reset Heroic Strike to 18 seconds without success CDR.")

	main.load_warrior_test_build(warrior,4);var summon:Dictionary=main.enemies.filter(func(enemy):return str(enemy.get("target_category",""))=="summon")[0];summon.pos=warrior.pos+Vector2(100,0);summon.remaining_lifetime=25.0;summon.original_lifetime=25.0;summon.hp=10000.0;summon.max_hp=10000.0;var summon_before:=float(summon.hp);main.cast_warrior_lions_fang(warrior,summon.pos)
