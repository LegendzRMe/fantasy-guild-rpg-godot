extends RefCounted
const PriestData=preload("res://scripts/data/priest_data.gd")
const PriestSystem=preload("res://scripts/systems/priest_system.gd")
static func amount(hero:Dictionary,value:float)->int:return floori(PriestSystem.ability_amount(hero,value))
static func details(hero:Dictionary,key:String,heroic_id:String="")->Dictionary:
	match key:
		"Q":return {"key":"Q","title":"Flash Heal","meta":"Cooldown: 5 seconds • Cast: 0.75 seconds","description":"At completion, heal the most-wounded living ally in range for %d. Full-Health recipients and overhealing are valid."%amount(hero,PriestData.VALUES.q_heal),"sections":[{"heading":"ALLY RESOLUTION","body":"Lowest Health percentage, then largest missing Health, nearest distance, and stable combat ID."}],"note":"Movement and crowd control interrupt the cast before release."}
		"W":return {"key":"W","title":"Divine Star","meta":"Cooldown: 10 seconds • Directional","description":"Send a star outward for %d Magical damage, then back toward Priest to heal each allied contact for %d."%[amount(hero,PriestData.VALUES.w_damage),amount(hero,PriestData.VALUES.w_heal)],"sections":[{"heading":"TRAVELING EFFECT","body":"Each enemy can be damaged once outbound and each ally healed once on return. Positioning changes the return route."}],"note":"Up to five qualifying Hero-like contacts contribute to telemetry."}
		"E":return {"key":"E","title":"Chastise","meta":"Cooldown: 9 seconds • Root: 1.25 seconds","description":"Launch a line projectile that deals %d Magical damage and Roots the first enemy hit."%amount(hero,PriestData.VALUES.e_damage),"sections":[],"note":"Piercing Light allows one additional target."}
		"R":
			if heroic_id=="priest_l15_r1":return {"key":"R","title":"Holy Word: Salvation","meta":"Cooldown: 80 seconds • 0.5-second startup • 3-second channel","description":"Heal nearby allies for 30% maximum Health over the full channel and make them Protected.","sections":[{"heading":"PROTECTED","body":"Prevents damage without consuming Shields. Movement and crowd control can interrupt the channel."}],"note":"Light of Stormwind also makes other allies Invulnerable."}
			if heroic_id=="priest_l15_r2":return {"key":"R","title":"Lightbomb","meta":"Cooldown: 60 seconds • Delay: 1.5 seconds","description":"Bomb the closest other ally, or Priest as fallback, for %d Magical damage, a 1.25-second Stun, and a %d Shield."%[amount(hero,PriestData.VALUES.r2_damage),amount(hero,PriestData.VALUES.r2_shield)],"sections":[],"note":"The recipient is locked when cast."}
			return {"key":"R","title":"Heroic Ability","meta":"Unlocks at Level 15","description":"Choose Holy Word: Salvation or Lightbomb in the Talent tree.","sections":[],"note":""}
		"D":return {"key":"D","title":"Pursued by Grace / Eternal Vanguard","meta":"Passive Trait • No resource","description":"Successful Basic Attacks heal the most-wounded nearby ally for %d. Lethal damage begins Spirit Form for 8 seconds."%floori(PriestSystem.trait_amount(hero,float(PriestData.VALUES.pursued_heal))),"sections":[{"heading":"SPIRIT FORM","body":"Priest is Invulnerable and untargetable, cannot receive healing or Shields, and can use Basic Attacks plus Q/W/E. Heroics are blocked."}],"note":"Without Redemption, Priest is incapacitated when Spirit Form expires."}
	return {"key":key,"title":"Priest Ability","meta":"","description":"","sections":[],"note":""}
