extends RefCounted
const SentinelData=preload("res://scripts/data/sentinel_data.gd")
const SentinelSystem=preload("res://scripts/systems/sentinel_system.gd")
static func amount(hero:Dictionary,value:float)->int:return floori(SentinelSystem.ability_amount(hero,value))
static func details(hero:Dictionary,key:String,heroic_id:String="")->Dictionary:
	match key:
		"Q":return {"key":"Q","title":"Light of Elune","meta":"2 charges • 16 second full-pair recharge • Automatic ally","description":"Heal the lowest current Health-percentage allied Hero in range for %d. Basic Attacks and qualifying ability damage reduce its active recharge."%amount(hero,SentinelData.VALUES.q_heal),"sections":[{"heading":"TARGETING","body":"Includes self and full-Health allies. Ties use party order, then combat ID."}],"note":"One recharge completion restores both charges simultaneously."}
		"W":return {"key":"W","title":"Sentinel Shot","meta":"Cooldown: %s seconds • Directional projectile"%str(SentinelSystem.w_cooldown(hero)),"description":"Fire a long projectile for %d base Magical damage. Damage grows linearly with total distance traveled, up to the shared +250%% ceiling, and Reveals enemies for 5 seconds."%amount(hero,SentinelData.VALUES.w_damage),"sections":[{"heading":"DEATH RESET","body":"If a target dies during this Sentinel's active W Reveal, restore one useful W charge once."}],"note":"At 20 Lunar Flare stacks it pierces the first unique target."}
		"E":return {"key":"E","title":"Lunar Flare","meta":"Cooldown: 13 seconds • 0.75 second warning","description":"After the warning, deal %d Magical damage and Stun enemies for 0.75 seconds."%amount(hero,SentinelData.VALUES.e_damage),"sections":[{"heading":"ENCOUNTER QUEST","body":"Qualifying hits and deaths within 3 seconds grant stacks. Each adds 3% damage, up to +250%. Rewards unlock at 10, 20, and 40 stacks."}],"note":"Training targets, summons, objects, and temporary combatants do not progress the quest."}
		"R":
			if heroic_id=="sentinel_l15_r1":return {"key":"R","title":"Shadowstalk","meta":"Cooldown: 90 seconds • Party Heroic","description":"Stealth allied Heroes and heal each for %d over 10 seconds. Standing still for 1.5 seconds grants Invisibility."%amount(hero,SentinelData.VALUES.r1_total_heal),"sections":[],"note":"Does not leave combat, clear Threat, or end the encounter."}
			if heroic_id=="sentinel_l15_r2":return {"key":"R","title":"Starfall","meta":"Cooldown: 80 seconds • Ground Heroic","description":"Create a six-second area dealing %d Magical damage per second and Slowing enemies by 20%%."%amount(hero,SentinelData.VALUES.r2_dps),"sections":[],"note":"Celestial Wrath upgrades the Slow and applies Hunter's Mark each tick."}
			return {"key":"R","title":"Heroic Ability","meta":"Unlocks at Level 15","description":"Choose Shadowstalk or Starfall from the Talent tree.","sections":[],"note":""}
		"D":return {"key":"D","title":"Hunter's Mark","meta":"Cooldown: 20 seconds • Enemy target","description":"Reveal an enemy for 4 seconds and reduce its Armor by 15. Successful Basic Attacks heal Sentinel for 1%% maximum Health, doubled against its own mark.","sections":[{"heading":"CONCEALED FALLBACK","body":"With no selected valid target, searches deterministically for the closest revealable Stealthed or Invisible enemy in range."}],"note":"Unrevealable targets are skipped; failure spends no cooldown."}
	return {"key":key,"title":"Sentinel Ability","meta":"","description":"","sections":[],"note":""}
