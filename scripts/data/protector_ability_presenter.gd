extends RefCounted
const ProtectorData=preload("res://scripts/data/protector_data.gd")
const ProtectorSystem=preload("res://scripts/systems/protector_system.gd")
static func amount(hero:Dictionary,value:float)->int:return floori(ProtectorSystem.ability_amount(hero,value))
static func details(hero:Dictionary,key:String,heroic_id:String="")->Dictionary:
	match key:
		"Q":return {"key":"Q","title":"El'druin's Might","meta":"Cooldown: 12 seconds • Ground target / recast","description":"Throw El'druin, dealing %d Physical damage and Slowing enemies by 30%% for 2.5 seconds. Recast within 5 seconds to teleport to the sword, reapply the Slow, and knock nearby enemies away."%amount(hero,ProtectorData.VALUES.q_damage),"sections":[{"heading":"TEMPORARY TERRAIN","body":"The throw and teleport may cross this Protector's own Force Wall, but still respect permanent and unrelated blockers."}],"note":"The teleport deals no additional damage."}
		"W":return {"key":"W","title":"Force Wall","meta":"Cooldown: %s seconds • Ground target"%str(ProtectorSystem.wall_cooldown(hero)),"description":"After 0.5 seconds, create an indestructible movement-only wall for %s seconds. It blocks all units, including bosses and allies, but not attacks, projectiles, vision, or abilities."%str(ProtectorSystem.wall_duration(hero)),"sections":[{"heading":"ORIENTATION","body":"The wall forms perpendicular to the direction from the Protector to the chosen point."}],"note":"Units overlapping the wall are moved to the nearest safe side."}
		"E":return {"key":"E","title":"Smite","meta":"Cooldown: 6 seconds • Ground target","description":"Damage enemies in a wide path for %d Magical damage. The field lasts %s seconds; allied Heroes moving through it gain 25%% Movement Speed for %s seconds."%[amount(hero,ProtectorData.VALUES.e_damage),str(ProtectorSystem.smite_duration(hero)),str(ProtectorSystem.smite_buff_duration(hero))],"sections":[{"heading":"PARTY SUPPORT","body":"The Protector also receives the movement blessing. Overlapping fields refresh but do not stack."}],"note":"Smite can cross and overlap Force Wall."}
		"R":
			if heroic_id=="protector_l15_r1":return {"key":"R","title":"Judgment","meta":"Cooldown: %s seconds • Enemy target"%str(ProtectorSystem.judgment_cooldown(hero)),"description":"After 0.75 seconds, charge the enemy for %d damage and Stun it for 1.5 seconds. Nearby enemies take %d damage and are knocked away."%[amount(hero,ProtectorData.VALUES.r1_damage),amount(hero,ProtectorData.VALUES.r1_secondary_damage)],"sections":[],"note":"May cross this Protector's own Force Wall."}
			if heroic_id=="protector_l15_r2":return {"key":"R","title":"Sanctification","meta":"Cooldown: 85 seconds • 0.5-second cast","description":"Create a field for %s seconds. The Protector and allied Heroes inside are Invulnerable."%str(ProtectorSystem.sanctification_duration(hero)),"sections":[],"note":"Holy Arena also increases allied damage inside by 25%."}
			return {"key":"R","title":"Heroic Ability","meta":"Unlocks at Level 15","description":"Choose Judgment or Sanctification from the Talent tree.","sections":[],"note":""}
		"D":return {"key":"D","title":"Archangel's Wrath","meta":"Automatic Trait • Activates on defeat","description":"On defeat, become an Invulnerable movement-only spirit for 4 seconds with 20%% more Movement Speed. Nearby enemies deal 50%% less damage. Then explode for %d damage and remain defeated."%amount(hero,ProtectorData.VALUES.trait_damage),"sections":[{"heading":"OUTGOING DAMAGE REDUCTION","body":"Enemies hit by the explosion retain the 50% reduction for 3 seconds. Strongest reduction wins; separate sources do not stack."}],"note":"Aspect of Justice later adds a separate living cast with its own 120-second cooldown."}
	return {"key":key,"title":"Protector Ability","meta":"","description":"","sections":[],"note":""}
