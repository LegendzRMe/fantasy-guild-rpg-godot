extends RefCounted
const ShamanData=preload("res://scripts/data/shaman_data.gd")
const ShamanSystem=preload("res://scripts/systems/shaman_system.gd")
static func amount(hero:Dictionary,value:float)->int:return floori(ShamanSystem.ability_amount(hero,value))
static func details(hero:Dictionary,key:String,heroic_id:String="")->Dictionary:
	match key:
		"Q":return {"key":"Q","title":"Chain Lightning","meta":"Cooldown: %s seconds • Enemy target"%str(ShamanData.VALUES.q_cooldown),"description":"Strike the primary target for %d Magical damage, then bounce up to %d times for %d damage. Every successful damage event grants Frostwolf Resilience."%[amount(hero,ShamanData.VALUES.q_initial),int(ShamanData.VALUES.q_bounces),amount(hero,ShamanData.VALUES.q_bounce)],"sections":[{"heading":"CROWD SPECIALIST","body":"Bounce choices are deterministic. Encounter quest rewards and character Mythic mastery are tracked separately."}],"note":"Stormcaller echoes cannot recursively create another echo."}
		"W":return {"key":"W","title":"Feral Spirit","meta":"Cooldown: 10 seconds • Directional","description":"Send a spirit that deals %d Magical damage and Roots for 1 second. Each unique qualifying contact adds 25%% of base travel distance with no numerical target cap."%amount(hero,ShamanData.VALUES.w_damage),"sections":[{"heading":"TRAVEL","body":"Only battlefield bounds and authored geometry limit the final distance. Boss control profiles can resist Root without preventing damage or travel extension."}],"note":"Spirit of the Pack creates an independently extending return spirit."}
		"E":return {"key":"E","title":"Windfury","meta":"Cooldown: 12 seconds • 3 empowered attacks","description":"Gain 30% Movement Speed for 4 seconds. The next three Basic Attacks occur 100% faster and each grants Frostwolf Resilience.","sections":[],"note":"The action bar shows the remaining empowered attacks."}
		"R":
			if heroic_id=="shaman_l15_r1":return {"key":"R","title":"Sundering","meta":"Cooldown: 70 seconds • Delay: 0.5 seconds","description":"Split a long line for %d Magical damage, shove enemies sideways, and request a 1-second Stun."%amount(hero,ShamanData.VALUES.r1_damage),"sections":[],"note":"Worldbreaker leaves a real three-second movement-blocking rift."}
			if heroic_id=="shaman_l15_r2":return {"key":"R","title":"Earthquake","meta":"Cooldown: 100 seconds • 3 pulses","description":"Create three large pulses that each deal %d Magical damage and Slow enemies by 50%% for 2 seconds."%amount(hero,ShamanData.VALUES.r2_damage),"sections":[],"note":"Earthen Shields protects allies inside each pulse."}
			return {"key":"R","title":"Heroic Ability","meta":"Unlocks at Level 15","description":"Choose Sundering or Earthquake in the Talent tree.","sections":[],"note":""}
		"D":return {"key":"D","title":"Frostwolf Resilience","meta":"Passive Trait • Threshold: 5","description":"Damaging enemies with Abilities grants stacks. At 5 stacks, immediately heal for %d. Excess stacks remain and can trigger multiple activations."%amount(hero,ShamanData.VALUES.trait_heal),"sections":[{"heading":"NO RESOURCE","body":"Shaman has no Mana, Energy, Rage, or Maelstrom resource. Frostwolf is a Trait counter."}],"note":"Frostwolf's Grace makes D activatable when selected."}
	return {"key":key,"title":"Shaman Ability","meta":"","description":"","sections":[],"note":""}
