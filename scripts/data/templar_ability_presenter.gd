extends RefCounted
const TemplarData=preload("res://scripts/data/templar_data.gd")
const TemplarSystem=preload("res://scripts/systems/templar_system.gd")
static func amount(hero:Dictionary,value:float)->int:return floori(TemplarSystem.ability_amount(hero,value))
static func details(hero:Dictionary,key:String,heroic_id:String="")->Dictionary:
	match key:
		"Q":return {"key":"Q","title":"Blade Dash","meta":"Cooldown: 10 seconds • Directional","description":"Dash outward, dealing %d Physical damage to each enemy crossed, then return for %d damage. Each unique contact reduces Shield Overload's cooldown by 1 second, or 2 seconds for priority enemies."%[amount(hero,TemplarData.VALUES.q_outward),amount(hero,TemplarData.VALUES.q_return)],"sections":[{"heading":"MOVEMENT","body":"The complete outward-and-return path always ends at the cast origin."}],"note":"Solarite Reaper empowers only the outward hit."}
		"W":return {"key":"W","title":"Twin Blades","meta":"Cooldown: 4 seconds • Enemy target","description":"Charge a nearby enemy and perform 2 real Basic Attack strikes. Each successful strike reduces Shield Overload's cooldown by 4 seconds.","sections":[{"heading":"BASIC ATTACKS","body":"Each strike can trigger Basic Attack talents independently. Triple Strike adds a third strike."}],"note":"Amateur Opponent snapshots nearby enemies when cast."}
		"E":return {"key":"E","title":"Shield Ally","meta":"Cooldown: %s seconds • Automatic ally target"%str(TemplarSystem.e_cooldown(hero)),"description":"Shield the closest other living ally in range for %d for 3 seconds. Their damage creates equal additional threat for this Templar against the damaged enemy."%floori(TemplarSystem.e_shield_amount(hero)),"sections":[{"heading":"TARGETING","body":"Cannot target self. An invalid cast does not begin cooldown."}],"note":"The threat link persists for the full duration even if the Shield breaks."}
		"R":
			if heroic_id=="templar_l15_r1":return {"key":"R","title":"Suppression Pulse","meta":"Cooldown: 70 seconds • Global ground target","description":"Deal %d Magical damage and Blind enemies in the area for 4 seconds."%amount(hero,TemplarData.VALUES.r1_damage),"sections":[],"note":"Orbital Bombardment grants a second charge with a 10-second inter-use restriction."}
			if heroic_id=="templar_l15_r2":return {"key":"R","title":"Purifier Beam","meta":"Cooldown: 70 seconds • Global enemy target","description":"Call a beam that follows the target for 8 seconds, dealing %d Magical damage each second."%amount(hero,TemplarData.VALUES.r2_dps),"sections":[],"note":"Target Purified retargets when its target is defeated."}
			return {"key":"R","title":"Heroic Ability","meta":"Unlocks at Level 15","description":"Choose Suppression Pulse or Purifier Beam from the Talent tree.","sections":[],"note":""}
		"D":return {"key":"D","title":"Shield Overload","meta":"Passive Trait • 24-second cooldown","description":"After taking damage while below 75%% Health, gain a %d Shield for 5 seconds. Successful Basic Attacks reduce the cooldown by 4 seconds."%amount(hero,TemplarData.VALUES.trait_shield),"sections":[{"heading":"NO RESOURCE","body":"Templar uses no Mana, Energy, Rage, or secondary resource."}],"note":"Evaded, immune, and zero-damage attacks do not reduce the cooldown."}
	return {"key":key,"title":"Templar Ability","meta":"","description":"","sections":[],"note":""}
